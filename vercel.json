{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build && rm -rf node_modules",
  "functions": {
    "backend/main.py": {
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,frontend/public/**,backend/tests/**,docs/**,*.ipynb}"
    }
  }
}
